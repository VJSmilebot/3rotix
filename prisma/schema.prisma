// ================================
// CREATOR ONBOARDING (AUTO-CHECKLIST)
// ================================

model OnboardingConfig {
  id                 String   @id @default("default")
  activeVersion      Int      @default(1)
  locked             Boolean  @default(false) // if true, only SUPERADMIN can change config/steps
  updatedByUserId    String?
  updatedAt          DateTime @default(now()) @updatedAt

  @@schema("public")
}

model OnboardingStep {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  version          Int      @default(1)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)

  // Identity
  key              String   @db.VarChar(120) // stable key for code + signals (ex: "AGE_VERIFY", "PAYOUT_CONNECT")
  title            String   @db.VarChar(200)
  description      String?
  category         String   @default("core") @db.VarChar(50) // ex: core, safety, payout, compliance, profile

  // Logic
  isRequired       Boolean  @default(true)
  allowSelfAttest  Boolean  @default(true)  // user can mark complete (may require evidence)
  requiresReview   Boolean  @default(false) // if true, completion stays NEEDS_REVIEW until admin approves

  // Compliance targeting (so you can adapt by law/jurisdiction)
  jurisdictions    Json?    // example: { "countries":["US"], "states":["CA","FL"], "tags":["2257"] }
  evidenceType     OnboardingEvidenceType @default(NONE)
  evidenceHint     String?  // short helper text for upload/what counts as proof

  // Auto-completion rules (flexible JSON)
  // examples:
  // { "signalKey":"AGE_VERIFIED", "equals":true }
  // { "userField":"handle", "exists":true }
  // { "all":[ {..},{..} ] } / { "any":[ {..},{..} ] }
  autoRule         Json?

  // Optional rewards later (we’ll wire XP/badges AFTER tool is stable)
  xpReward         Int      @default(0)
  badgeKey         String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  userSteps        UserOnboardingStep[]

  @@unique([version, key])
  @@index([isActive, version, sortOrder])
  @@schema("public")
}

model UserOnboardingStep {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId           String
  stepId           String

  status           OnboardingStepStatus @default(PENDING)

  // “both match = more probable”
  selfAttested     Boolean  @default(false)
  autoDetected     Boolean  @default(false)

  completedAt      DateTime?
  completedBy      OnboardingCompletedBy @default(USER)

  // Evidence (optional)
  evidenceUrl      String?  // if you store in Supabase Storage
  evidenceJson     Json?    // or store structured proof data
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  step             OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, stepId])
  @@index([userId, status])
  @@schema("public")
}

model OnboardingSignal {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId           String
  key              String   @db.VarChar(120) // ex: "AGE_VERIFIED", "PAYOUT_CONNECTED", "DOC_2257_SIGNED"
  valueJson        Json?
  isTrue           Boolean  @default(false)

  // audit-ish
  source           String?  @db.VarChar(80) // "keysako", "manual_admin", "payment_partner", "system"
  verifiedByUserId String?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, key])
  @@index([key, isTrue])
  @@schema("public")
}

model OnboardingAuditLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?
  actorUserId String?
  action      String   @db.VarChar(80) // "STEP_COMPLETED", "STEP_RESET", "STEP_EDITED", "AUTO_EVALUATED"
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@schema("public")
}

