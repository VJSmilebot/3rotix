  @@index([workspace_id], map: "idx_collabfile_workspace")
  @@schema("public")
}

model CollabProposal {
  id                                          String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  created_by_id                               String
  recipient_handle                            String
  recipient_user_id                           String?
  status                                      String                    @default("DRAFT")
  title                                       String?
  created_at                                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime                  @default(now()) @db.Timestamptz(6)
  CollabAgreementSnapshot                     CollabAgreementSnapshot[]
  User_CollabProposal_created_by_idToUser     User                      @relation("CollabProposal_created_by_idToUser", fields: [created_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_CollabProposal_recipient_user_idToUser User?                     @relation("CollabProposal_recipient_user_idToUser", fields: [recipient_user_id], references: [id], onUpdate: NoAction)
  CollabTerm                                  CollabTerm[]
  CollabWorkspace                             CollabWorkspace?

  @@index([created_by_id], map: "idx_collabproposal_created_by")
  @@index([recipient_handle], map: "idx_collabproposal_recipient_handle")
  @@index([recipient_user_id], map: "idx_collabproposal_recipient_user")
  @@schema("public")
}

model CollabTerm {
  id                                                                String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  proposal_id                                                       String
  term_key                                                          String
  is_required                                                       Boolean             @default(true)
  status                                                            String              @default("PROPOSED")
  active_version_id                                                 String?
  created_at                                                        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                                        DateTime            @default(now()) @db.Timestamptz(6)
  CollabProposal                                                    CollabProposal      @relation(fields: [proposal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  CollabTermVersion_CollabTerm_active_version_idToCollabTermVersion CollabTermVersion?  @relation("CollabTerm_active_version_idToCollabTermVersion", fields: [active_version_id], references: [id], onUpdate: NoAction, map: "collabterm_active_version_fk")
  CollabTermComment                                                 CollabTermComment[]
  CollabTermVersion_CollabTermVersion_term_idToCollabTerm           CollabTermVersion[] @relation("CollabTermVersion_term_idToCollabTerm")

  @@unique([proposal_id, term_key])
  @@index([active_version_id], map: "idx_collabterm_active_version")
  @@index([proposal_id], map: "idx_collabterm_proposal")
  @@schema("public")
}

model CollabTermComment {
  id         String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  term_id    String
  author_id  String
  body       String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  User       User       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  CollabTerm CollabTerm @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([term_id], map: "idx_collabtermcomment_term")
  @@schema("public")
}

model CollabTermVersion {
  id                                                         String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  term_id                                                    String
  created_by_id                                              String
  value_json                                                 Json         @default("{}")
  created_at                                                 DateTime     @default(now()) @db.Timestamptz(6)
  CollabTerm_CollabTerm_active_version_idToCollabTermVersion CollabTerm[] @relation("CollabTerm_active_version_idToCollabTermVersion")
  User                                                       User         @relation(fields: [created_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  CollabTerm_CollabTermVersion_term_idToCollabTerm           CollabTerm   @relation("CollabTermVersion_term_idToCollabTerm", fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([term_id], map: "idx_collabtermversion_term")
  @@schema("public")
}

model CollabWorkspace {
  id                      String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
