model onboarding_step {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version              Int                    @default(1)
  sort_order           Int                    @default(0)
  is_active            Boolean                @default(true)
  key                  String                 @db.VarChar(120)
  title                String                 @db.VarChar(200)
  description          String?
  category             String                 @default("core") @db.VarChar(50)
  is_required          Boolean                @default(true)
  allow_self_attest    Boolean                @default(true)
  requires_review      Boolean                @default(false)
  jurisdictions        Json?
  evidence_type        String                 @default("NONE") @db.VarChar(20)
  evidence_hint        String?
  auto_rule            Json?
  xp_reward            Int                    @default(0)
  badge_key            String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  user_onboarding_step user_onboarding_step[]

  @@unique([version, key])
  @@index([is_active, version, sort_order], map: "onboarding_step_active_version_order")
  @@schema("public")
}

model user_onboarding_step {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String
  step_id         String          @db.Uuid
  status          String          @default("PENDING") @db.VarChar(20)
  self_attested   Boolean         @default(false)
  auto_detected   Boolean         @default(false)
  completed_at    DateTime?       @db.Timestamptz(6)
  completed_by    String          @default("USER") @db.VarChar(20)
  evidence_url    String?
  evidence_json   Json?
  notes           String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  onboarding_step onboarding_step @relation(fields: [step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, step_id])
  @@index([user_id, status], map: "user_onboarding_step_user_status")
  @@schema("public")
}

