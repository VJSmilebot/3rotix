generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model Achievement {
  id          String   @id
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  description String?
  category    String   @db.VarChar(50)
  xpReward    Int      @default(0)
  icon        String?  @db.VarChar(255)
  targetValue Int      @default(1)
  secret      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@schema("public")
}

model User {
  id                                      String            @id
  email                                   String            @unique
  name                                    String?
  handle                                  String?           @unique
  image                                   String?
  role                                    Role              @default(FAN)
  isSuperAdmin                            Boolean           @default(false)
  totalXp                                 Int               @default(0)
  rank                                    Rank              @default(ROOKIE)
  level                                   Int               @default(1)
  currentLevelXp                          Int               @default(0)
  createdAt                               DateTime          @default(now())
  updatedAt                               DateTime          @updatedAt
  bio                                     String?
  instagram                               String?
  twitter                                 String?
  website                                 String?
  isPublic                                Boolean           @default(true)
  chatMessages                            ChatMessage[]
  clips                                   Clip[]
  content                                 Content[]
  follows                                 Follow[]          @relation("UserFollows")
  followers                               Follow[]          @relation("UserFollowers")
  messageReactions                        MessageReaction[]
  notifications                           Notification[]
  recordings                              Recording[]
  registeredWorks                         RegisteredWork[]  @relation("UserRegisteredWorks")
  streams                                 Stream[]
  Tip_Tip_fromuseridToUser                Tip[]             @relation("Tip_fromuseridToUser")
  Tip_Tip_touseridToUser                  Tip[]             @relation("Tip_touseridToUser")
  Transaction_Transaction_creatoridToUser Transaction[]     @relation("Transaction_creatoridToUser")
  Transaction_Transaction_useridToUser    Transaction[]     @relation("Transaction_useridToUser")
  onboardingSteps                         UserOnboardingStep[]
  onboardingSignals                       OnboardingSignal[]
  Wallet                                  Wallet?

  @@index([handle])
  @@index([rank])
  @@index([totalXp(sort: Desc)])
  @@schema("public")
}

model Video {
  id                     String                @id
  userId                 String
  title                  String                @db.VarChar(255)
  description            String?
  playbackId             String?               @db.VarChar(255)
  assetId                String?               @db.VarChar(255)
  visibility             String                @default("private") @db.VarChar(50)
  thumbnailUrl           String?
  duration               Int?
  views                  Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  fingerprintSha256      String?               @db.VarChar(128)
  primaryRegisteredWorks RegisteredWork[]      @relation("VideoPrimaryRegisteredWorks")
  registeredWorkAssets   RegisteredWorkAsset[] @relation("VideoRegisteredWorkAssets")

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([visibility])
  @@schema("public")
}

model Image {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  title        String?
  description  String?
  url          String
  storageKey   String
  visibility   String?   @default("public")
  thumbnailUrl String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  users        users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_image_userid")
  @@schema("public")
}

model Squad {
  id           String        @id
  name         String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(100)
  description  String?
  level        Int           @default(1)
  totalXp      Int           @default(0)
  memberCount  Int           @default(0)
  type         SquadType     @default(PUBLIC)
  ownerId      String
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  maxMembers   Int           @default(10)
  bio          String?
  image        String?
  banner       String?
  chatEnabled  Boolean?      @default(true)
  slowMode     Int?
  mediaEnabled Boolean?      @default(true)
  website      String?
  twitter      String?
  instagram    String?
  discord      String?
  chatMessages ChatMessage[]
  content      Content[]

  @@index([creatorId])
  @@index([ownerId])
  @@index([totalXp(sort: Desc)])
  @@schema("public")
}

model SquadMember {
  id             String   @id
  squadId        String
  userId         String
  role           String   @default("member")
  contributionXp Int      @default(0)
  lastActive     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([squadId, userId])
  @@index([contributionXp(sort: Desc)])
  @@index([squadId])
  @@index([userId])
  @@schema("public")
}

model ChatMessage {
  id        String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  squadId   String
  userId    String
  content   String
  mediaUrl  String?
  mediaType String?
  isEdited  Boolean?          @default(false)
  isPinned  Boolean?          @default(false)
  isDeleted Boolean?          @default(false)
  deletedBy String?
  deletedAt DateTime?         @db.Timestamp(6)
  replyToId String?
  createdAt DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt DateTime?         @default(now()) @db.Timestamp(6)
  replyTo   ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id], onUpdate: NoAction, map: "fk_reply")
  replies   ChatMessage[]     @relation("MessageReplies")
  squad     Squad             @relation(fields: [squadId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_squad")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
  reactions MessageReaction[]

  @@index([squadId])
  @@index([userId])
  @@index([createdAt])
  @@schema("public")
}

model MessageReaction {
  id        String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String
  userId    String
  emoji     String
  createdAt DateTime?   @default(now()) @db.Timestamp(6)
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@unique([messageId, userId, emoji], map: "unique_reaction")
  @@schema("public")
}

model Content {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  squadId   String
  userId    String
  type      String?   @default("POST")
  title     String?
  content   String?
  mediaUrl  String?
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  squad     Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_squad")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@schema("public")
}

model Stream {
  id           String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String
  title        String
  description  String?
  streamKey    String      @unique
  playbackId   String?
  isActive     Boolean?    @default(false)
  status       String?     @default("IDLE")
  viewerCount  Int?        @default(0)
  thumbnailUrl String?
  startedAt    DateTime?   @db.Timestamp(6)
  endedAt      DateTime?   @db.Timestamp(6)
  createdAt    DateTime?   @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?   @default(now()) @updatedAt @db.Timestamp(6)
  clips        Clip[]
  recordings   Recording[]
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@schema("public")
}

model Recording {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  streamId     String
  userId       String
  title        String
  playbackId   String?
  assetId      String?
  duration     Int?
  thumbnailUrl String?
  views        Int?      @default(0)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  stream       Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stream")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@schema("public")
}

model Clip {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  streamId     String?
  userId       String
  title        String
  playbackId   String?
  assetId      String?
  startTime    Int
  endTime      Int
  duration     Int?
  thumbnailUrl String?
  views        Int?      @default(0)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  stream       Stream?   @relation(fields: [streamId], references: [id], onUpdate: NoAction, map: "fk_stream")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@schema("public")
}

model Follow {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  followerId  String
  followingId String
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  follower    User      @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_follower")
  following   User      @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_following")

  @@unique([followerId, followingId], map: "unique_follow")
  @@schema("public")
}

model Notification {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean?  @default(false)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@schema("public")
}

model ChatPerk {
  id            String         @id
  squadId       String
  permission    ChatPermission
  requiredLevel Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([squadId, permission])
  @@schema("public")
}

model SquadAchievement {
  id            String    @id @default(uuid())
  squadId       String
  achievementId String
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([squadId, achievementId])
  @@index([squadId, completed])
  @@schema("public")
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, achievementId])
  @@index([userId, completed])
  @@schema("public")
}

model XPLog {
  id             String       @id @default(uuid())
  userId         String
  xpValue        Int
  refId          String?
  ipHash         String?
  userAgent      String?
  idempotencyKey String?
  createdAt      DateTime     @default(now())
  actionType     XPActionType

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@schema("public")
}

model SquadMute {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  squadId   String
  userId    String
  mutedBy   String
  reason    String?
  mutedAt   DateTime? @default(now()) @db.Timestamp(6)
  muteUntil DateTime  @db.Timestamp(6)

  @@unique([squadId, userId], map: "unique_mute")
  @@index([squadId])
  @@index([muteUntil])
  @@schema("public")
}

model SquadBan {
  id       String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  squadId  String
  userId   String
  bannedBy String
  reason   String?
  bannedAt DateTime? @default(now()) @db.Timestamp(6)

  @@unique([squadId, userId], map: "unique_ban")
  @@index([squadId])
  @@schema("public")
}

model ModeratorLog {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  squadId     String
  moderatorId String
  action      String
  targetId    String?
  reason      String?
  metadata    Json?
  createdAt   DateTime? @default(now()) @db.Timestamp(6)

  @@index([squadId])
  @@index([moderatorId])
  @@index([createdAt])
  @@schema("public")
}

model SquadChat {
  id          String           @id
  squadId     String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isOpen      Boolean          @default(true)
  mutedUntil  DateTime?
  permissions ChatPermission[] @default([TEXT])

  @@schema("public")
}

model SquadChatMessage {
  id        String   @id
  chatId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@index([userId])
  @@schema("public")
}

model BannedUsers {
  A String
  B String

  @@id([A, B], map: "_BannedUsers_AB_pkey")
  @@index([B], map: "_BannedUsers_B_index")
  @@map("_BannedUsers")
  @@schema("public")
}

model ChatModerators {
  A String
  B String

  @@id([A, B], map: "_ChatModerators_AB_pkey")
  @@index([B], map: "_ChatModerators_B_index")
  @@map("_ChatModerators")
  @@schema("public")
}

model RegisteredWork {
  id               String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerId          String
  title            String
  description      String?
  mediaId          String
  status           RegisteredWorkStatus  @default(ACTIVE)
  registeredAt     DateTime              @default(now()) @db.Timestamptz(6)
  isForSale        Boolean               @default(false)
  priceCents       Int?
  officialLinks    Json?
  allowedPlatforms Json?
  archivedAt       DateTime?             @db.Timestamptz(6)
  deletedAt        DateTime?             @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  fingerprints     ContentFingerprint[]  @relation("RegisteredWorkFingerprints")
  media            Video                 @relation("VideoPrimaryRegisteredWorks", fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  owner            User                  @relation("UserRegisteredWorks", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assets           RegisteredWorkAsset[] @relation("RegisteredWorkAssets")

  @@schema("public")
}

model ContentFingerprint {
  id               String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  registeredWorkId String
  algorithm        FingerprintAlgorithm
  value            String
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  registeredWork   RegisteredWork       @relation("RegisteredWorkFingerprints", fields: [registeredWorkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model Wallet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("userid")
  lipzBalance   Int      @default(0) @map("lipzbalance")
  earningsCents Int      @default(0) @map("earningscents")
  currency      String   @default("USD") @db.VarChar(10)
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("createdat")
  updatedAt     DateTime @default(now()) @db.Timestamptz(6) @map("updatedat")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model Tip {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId  String   @map("fromuserid")
  toUserId    String   @map("touserid")
  lipzAmount  Int      @map("lipzamount")
  message     String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("createdat")

  fromUser    User     @relation("Tip_fromuseridToUser", fields: [fromUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toUser      User     @relation("Tip_touseridToUser", fields: [toUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_tip_created")
  @@index([fromUserId], map: "idx_tip_from_user")
  @@index([toUserId], map: "idx_tip_to_user")
  @@schema("public")
}

model Transaction {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String          @map("userid")
  creatorId        String?         @map("creatorid")
  type             TransactionType
  lipzAmount       Int             @default(0) @map("lipzamount")
  amountCents      Int             @default(0) @map("amountcents")
  platformFeeCents Int             @default(0) @map("platformfeecents")
  creatorNetCents  Int             @default(0) @map("creatornetcents")
  metadata         Json?
  createdAt        DateTime        @default(now()) @db.Timestamptz(6) @map("createdat")

  creator          User?           @relation("Transaction_creatoridToUser", fields: [creatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User            @relation("Transaction_useridToUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_tx_created")
  @@index([creatorId], map: "idx_tx_creator")
  @@index([userId], map: "idx_tx_user")
  @@schema("public")
}

model Bundle {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  description String?
  coverImage  String?
  price       Int      // Lipz price
  type        BundleType @default(PHOTOSET)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       BundleItem[]
  purchases   BundlePurchase[]

  @@index([creatorId])
  @@index([isActive])
  @@index([createdAt(sort: Desc)])
  @@schema("public")
}

model BundleItem {
  id        String   @id @default(uuid())
  bundleId  String
  mediaType String   // VIDEO, IMAGE, AUDIO
  mediaId   String   // References Video, Image, or Audio
  order     Int      @default(0)
  createdAt DateTime @default(now())

  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@schema("public")
}

model BundlePurchase {
  id          String   @id @default(uuid())
  bundleId    String
  userId      String
  lipzPaid    Int
  purchasedAt DateTime @default(now())

  bundle      Bundle   @relation(fields: [bundleId], references: [id])

  @@unique([bundleId, userId])
  @@index([userId])
  @@index([purchasedAt(sort: Desc)])
  @@schema("public")
}

enum BundleType {
  PHOTOSET
  VIDEO_PACK
  MIXED
 
  @@schema("public")
}
  
model PlatformSettings {
  id                       String   @id @default("default")
  globalplatformcutpercent Int      @default(10)
  lipztocentrate           Int      @default(10)
  createdat                DateTime @default(now()) @db.Timestamptz(6)
  updatedat                DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model RegisteredWorkAsset {
  id               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  registeredWorkId String
  mediaId          String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  media            Video          @relation("VideoRegisteredWorkAssets", fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  registeredWork   RegisteredWork @relation("RegisteredWorkAssets", fields: [registeredWorkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
